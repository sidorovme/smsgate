mqtt:
  broker: "192.168.1.2"
  port: 1883

db_path: "sms.db"
multipart_timeout_sec: 300

# Отправка SMS (команда /send в Telegram-чате шлюза)
send_max_parts: 6              # максимум частей в одном сообщении
send_rate_limit_per_min: 5     # максимум отправок в минуту на шлюз
send_result_timeout_sec: 120   # сколько ждать ответа шлюза

# availability_topic — топик keep-alive/LWT шлюза (online/offline).
# По умолчанию выводится из mqtt_topic: sms/incoming/<x> → sms/status/<x>/availability.
# Задавайте явно, только если топик в прошивке отличается от этой схемы.
# Топики отправки выводятся из mqtt_topic: sms/incoming/<x> → sms/send/<x>,
# sms/send-result/<x>, sms/report/<x> (можно задать явно: send_topic, send_result_topic, report_topic).
gateways:
  - name: "gate-1"
    mqtt_topic: "sms/incoming/gate-1"
    # availability_topic: "sms/status/gate-1/availability"
    telegram_bot_token: "123456:ABC-DEF..."
    telegram_chat_id: "-100123456789"

  - name: "gate-2"
    mqtt_topic: "sms/incoming/gate-2"
    telegram_bot_token: "654321:XYZ-UVW..."
    telegram_chat_id: "-100987654321"
